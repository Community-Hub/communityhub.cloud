 "narrative": {
  "northStar": "The Civic Brochure",
  "overview": "Community Hub sells a community-centered communication platform to cities, neighborhoods, schools, campuses and museums. The site reads like a well-made town brochure: one idea per page, turned one page at a time, with the real film, real places and real people doing the persuading. The look is the category standard played straight at Apple's level of finish: a white page, Community Hub's own greens, one lime action, generous space, and photography and live dashboards as the only decoration.",
  "keyCharacteristics": [
   "White page, pine type, leaf links, lime only for the primary action.",
   "Figtree for every word; Comfortaa only in the wordmark.",
   "Home sections are full-screen pages that snap into place.",
   "Real media leads: the film, installation photos, live embeds.",
   "Flat surfaces separated by hairlines and tinted page bands."
  ],
  "rules": [
   {
    "name": "The One Lime Rule",
    "body": "Lime marks the single primary action on a screen and the two highlighted words of the film. Nothing else is lime.",
    "section": "colors"
   },
   {
    "name": "The Page Is the Frame Rule",
    "body": "A reserved media box paints nothing of its own; a photo that does not fill it sits at its own shape on the page background.",
    "section": "elevation"
   },
   {
    "name": "The No Kicker Rule",
    "body": "Nothing sits above a heading: no eyebrow, category label or section number.",
    "section": "typography"
   }
  ],
  "dos": [
   "Do end every page with Contact us.",
   "Do show the real thing before describing it.",
   "Do keep each home page to one idea that fits a screen; use swipe strips on phones.",
   "Do pause anything that moves on its own on hover, focus or reduced motion.",
   "Do take every word from the editable content modules."
  ],
  "donts": [
   "Don't paint a background behind a photo that doesn't fill its box.",
   "Don't put a label, number or category above a heading.",
   "Don't invent prices, client counts or awards.",
   "Don't use gradient text, glassy cards, colored side borders or block shadows.",
   "Don't use a second display face."
  ]
 }
}